    "@tanstack/react-start": "^1.168.61",
    "@tanstack/react-virtual": "^3.14.22",
    "@tiptap/core": "3.22.2",
    "@tiptap/extension-emoji": "3.22.2",
    "@tiptap/extension-link": "3.22.2",
    "@tiptap/pm": "3.22.2",
    "@tiptap/react": "3.22.2",
    "@tiptap/starter-kit": "3.22.2",
    "@tiptap/suggestion": "3.22.2",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/lodash-es": "^4.17.12",
    "clsx": "^2.1.1",
