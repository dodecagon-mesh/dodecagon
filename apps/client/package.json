{
  "name": "client",
  "private": true,
  "version": "0.0.72",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "bun test",
    "test:visual": "vitest run --mode development --config vitest.config.ts",
    "test:visual:update": "vitest run --mode development --config vitest.config.ts --update",
    "lint": "eslint ./src --ext ts,tsx",
    "lint:fix": "eslint ./src --ext ts,tsx --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit --project tsconfig.app.json",
    "format": "prettier --write \"**/*.ts*\" --cache --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --cache --config ./.prettierrc.json",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
