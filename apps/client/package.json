    "@heroicons/react": "2.2.0",
    "@sentry/react": "^11.8.0",
    "@dodecagon/shared": "workspace:*",
    "@dodecagon/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/db": "0.15.2",
    "@tanstack/query-core": "5.104.5",
    "@tanstack/query-db-collection": "1.4.8",
