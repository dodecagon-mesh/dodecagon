{
  "name": "dodecagon",
  "version": "0.0.85",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "mediasoup"
  ],
  "scripts": {
    "test": "bun run --filter '*' test",
    "test:changed": "bun ./packages/scripts/src/test-changed.ts",
    "test:e2e": "bunx bun@1.4.4 run --filter '@dodecagon/e2e' test:e2e",
    "agent": "bun ./packages/scripts/src/agent-slot.ts",
    "agent:claim": "bun ./packages/scripts/src/agent-slot.ts claim",
    "agent:env": "bun ./packages/scripts/src/agent-slot.ts env",
    "agent:dev": "bun ./packages/scripts/src/agent-slot.ts dev",
    "agent:check": "bun ./packages/scripts/src/agent-slot.ts check",
    "agent:signoff": "bun ./packages/scripts/src/agent-slot.ts signoff",
    "agent:doctor": "bun ./packages/scripts/src/agent-slot.ts doctor",
    "agent:release": "bun ./packages/scripts/src/agent-slot.ts release",
    "agent:mcp": "bun ./packages/scripts/src/agent-slot.ts mcp",
    "agent:prune": "bun ./packages/scripts/src/prune-worktrees.ts",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check",
    "check-types": "bun run --filter '*' check-types",
    "lint": "bun run --filter '*' lint",
    "check:fast": "bun run format:check && bun run lint && bun run check-types",
    "verify": "bun run check:fast && bun run test && bun run --filter '@dodecagon/server' build && bun run --filter '@dodecagon/server' test:bundle",
    "signoff": "bunx bun@1.4.4 run signoff:local",
    "signoff:local": "bun install --frozen-lockfile && bun run verify && bun run --filter '@dodecagon/e2e' test:e2e:shards && gh signoff build e2e",
    "probe": "bun run --filter '@dodecagon/scripts' probe",
    "magic": "bun run format && bun run check-types && bun run lint"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}