{
  "name": "@dodecagon/scripts",
  "version": "0.0.81",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "format": "prettier --write \"**/*.ts*\" --cache --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --cache --config ./.prettierrc.json",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "agent-slot": "bun ./src/agent-slot.ts",
    "prune-worktrees": "bun ./src/prune-worktrees.ts",
    "probe": "bun ./src/reachability-probe.ts",
    "synci18n": "bun ./src/sync-i18n.ts",
    "test-changed": "bun ./src/test-changed.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "peerDependencies": {
    "@types/linkify-it": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "eslint": "^8.56.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0"
  },
  "dependencies": {}
}