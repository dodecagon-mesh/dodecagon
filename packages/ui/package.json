{
  "name": "@dodecagon/ui",
  "version": "0.0.89",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "format": "prettier --write \"**/*.ts*\" --cache --config ./.prettierrc.json",
    "format:check": "prettier --check \"**/*.ts*\" --cache --config ./.prettierrc.json",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dodecagon/shared": "workspace:*",
    "@heroicons/react": "2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.11.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "eslint": "^8.56.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}